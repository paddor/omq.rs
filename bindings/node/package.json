{
  "name": "@paddor/omq-node",
  "version": "0.1.2",
  "description": "Native Node.js binding for OMQ.rs",
  "license": "ISC",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "doc/charts/bindings.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paddor/omq.rs.git",
    "directory": "bindings/node"
  },
  "bugs": {
    "url": "https://github.com/paddor/omq.rs/issues"
  },
  "homepage": "https://github.com/paddor/omq.rs/tree/main/bindings/node#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:debug": "napi build",
    "build:native": "napi build --release",
    "build:native:platform": "napi build --platform --release",
    "build:ts": "tsc -p tsconfig.json",
    "artifacts": "napi artifacts --output-dir artifacts",
    "release:prepare": "node scripts/prepare-release.js",
    "test": "node --test test/*.test.js",
    "bench": "node scripts/omq-node-bench.js",
    "chart": "python3 scripts/update_perf.py --chart-only",
    "soak": "node --expose-gc --test --test-concurrency=1 test/soak/*.test.js"
  },
  "napi": {
    "binaryName": "omq_node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.3.4",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "zeromq": "^6.5.0"
  }
}
