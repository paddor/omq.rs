    "description": "OMQ.php: the zmq PHP extension, with the ext-zmq API, on the OMQ engine",
    "type": "php-ext",
    "license": "ISC",
    "keywords": ["zmq", "zeromq", "omq", "messaging"],
    "homepage": "https://github.com/paddor/omq.rs/tree/main/bindings/php",
    "support": {
        "issues": "https://github.com/paddor/omq.rs/issues",
